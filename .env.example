# Backend / Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=your_postgres_connection_string_here
JWT_SECRET=your_jwt_secret_here

# Service runtime
NODE_ENV=production
PORT=8000

# API gateway service URLs
AUTH_URL=http://auth-service:8001
BARCODE_URL=http://barcode-service:8002
CLIENT_URL=http://client-service:8003
INVENTORY_URL=http://inventory-service:8000
CORS_ORIGIN=https://your-app-domain.example

# React frontend
REACT_APP_API_BASE_URL=https://api.your-app-domain.example

# Optional browser-safe Supabase values if frontend features require them
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
